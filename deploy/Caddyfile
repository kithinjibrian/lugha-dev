# The Lugha site behind Caddy (PRP-001, API-8 and API-10). Caddy listens on
# plain HTTP inside the compose network: Cloudflare handles the domain and
# HTTPS, and cloudflared brings visitors' requests here. The static site is
# services/ui-web's build, mounted at /srv; /api/* goes to the API.

:80 {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	handle /api/* {
		# Bodies past 512 KB never reach the API.
		request_body {
			max_size 512KB
		}
		# Cloudflare's CF-Connecting-IP passes through untouched: the API's rate
		# limit reads it.
		reverse_proxy api:8080 {
			# One request at a time until std.process stops blocking (API-7):
			# a request may wait behind another's run before its own starts.
			transport http {
				response_header_timeout 60s
			}
		}
	}

	handle {
		root * /srv
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}
