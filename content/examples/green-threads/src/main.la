//: An ordinary function. Nothing marks it as concurrent.
fun work(n: i64): i64 = n * n;

//: `spawn` starts a call on its own green thread and hands back a handle straight away.
fun main() {
    let a = spawn work(3);
    let b = spawn work(4);
//: `join` waits for a thread and gives back its result. Every function stays an ordinary function.
    println(a.join() + b.join());
}
