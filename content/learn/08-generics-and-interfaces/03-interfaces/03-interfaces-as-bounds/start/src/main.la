interface Shape {
    fun area(self): f64;
}

struct Square { side: f64 }

impl Square {
    fun area(self): f64 = self.side * self.side;
}

fun total<T: Shape>(shapes: T[]): f64 = shapes.fold(0.0, fun(sum, s) = sum + s.area());

fun main() {
    println(total([Square { side: 1.0 }, Square { side: 2.0 }]));
}
