interface Shape {
    fun area(self): f64;
    fun describe(self): string = "a shape of area {self.area()}";
}

struct Circle { r: f64 }
struct Square { side: f64 }

impl Circle {
    fun area(self): f64 = 3.14 * self.r * self.r;
}

impl Square {
    fun area(self): f64 = self.side * self.side;
    fun describe(self): string = "a square with side {self.side}";
}

fun main() {
    println(Circle { r: 1.0 }.describe());
    println(Square { side: 2.0 }.describe());
}
