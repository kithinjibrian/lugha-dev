interface Shape {
    fun area(self): f64;
}

struct Circle { r: f64 }
struct Square { side: f64 }

impl Circle {
    fun area(self): f64 = 3.0 * self.r * self.r;
}

impl Square {
    fun area(self): f64 = self.side * self.side;
}

fun main() {
    let shapes = [Circle { r: 1.0 }, Square { side: 2.0 }];
    println(shapes);
}
