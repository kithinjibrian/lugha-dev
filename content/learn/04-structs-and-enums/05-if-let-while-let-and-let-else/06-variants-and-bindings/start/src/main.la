enum Shape {
    Circle(f64),
    Rect(f64, f64),
    Empty,
}

fun describe(s: Option<Shape>): string {
    match s {
        Some(Emtpy) => "an empty shape",
        Some(Circle(r)) => "a circle of radius {r}",
        Some(Rect(w, h)) => "a {w} by {h} rectangle",
        None => "nothing",
    }
}

fun main() {
    println(describe(Some(Shape.Circle(1.5))));
}
