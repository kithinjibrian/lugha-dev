---
// The site's header: the logo home, the three pages, and GitHub. Home has no menu link; the logo
// is the way back.
import { copy, GITHUB } from "../lib/copy";
import Logo from "./Logo.astro";

interface Props {
  current?: "learn" | "examples" | "playground";
}
const { current } = Astro.props;
const links = [
  { id: "learn", href: "/learn", label: copy.nav.learn },
  { id: "examples", href: "/examples", label: copy.nav.examples },
  { id: "playground", href: "/playground", label: copy.nav.playground },
] as const;
---

<header class="header">
  <a class="home" href="/" aria-label={copy.nav.home}>
    <Logo size={28} />
    <span>lugha</span>
  </a>
  <nav aria-label="Main">
    {
      links.map((l) => (
        <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
  <div class="grow"></div>
  <a class="github" href={GITHUB}>
    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="currentColor"
        d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 2.9.8.1-.6.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9V21c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"
      ></path>
    </svg>
    {copy.nav.github}
  </a>
</header>

<style>
  .header {
    flex-shrink: 0;
    height: 64px;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    gap: 28px;
    border-bottom: 1px solid var(--line);
    background: var(--bar);
  }
  .home {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--target);
    text-decoration: none;
    color: var(--sand);
    font-size: 21px;
    font-weight: 800;
  }
  nav {
    display: flex;
    gap: 22px;
    align-self: stretch;
  }
  nav a {
    display: flex;
    align-items: center;
    font-size: 16px;
    text-decoration: none;
    color: var(--dust);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  nav a:hover {
    color: var(--sand);
  }
  nav a[aria-current="page"] {
    font-weight: 600;
    color: var(--link);
    border-bottom-color: var(--sun);
  }
  .grow {
    flex: 1;
  }
  .github {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    text-decoration: none;
    color: var(--sand-2);
    height: var(--target);
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    box-sizing: border-box;
  }
  @media (max-width: 640px) {
    .header {
      gap: 14px;
    }
    .home span,
    .github {
      display: none;
    }
    nav {
      gap: 14px;
    }
  }
</style>
