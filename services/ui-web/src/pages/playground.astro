---
// The Playground page: a frame for the `Playground` component, filling the window.
import Playground from "../components/playground/Playground.svelte";
import { site } from "../content/site";
import Site from "../layouts/Site.astro";

const s = await site();
---

<Site title="Playground · Lugha" current="playground" fill>
  <main class="playground">
    <Playground client:load opening={s.playground.source} />
  </main>
</Site>

<style>
  .playground {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
</style>
