// The content checks: every lesson step and every example
// in content/ runs through the real sandbox, exactly as a visitor's code
// would, and must print what its expected.txt says. A step with a solution
// is checked both ways: the start code gives its start_error (or prints its
// start_output), and the solution prints expected.txt. A step runs with every
// file under its start/ (or solution/). A step with test/ files is a test
// step: its solution's tests must all pass, and a start with start_failing
// must fail exactly those tests.
//
// Home's card (content/home) and the Playground's opening program
// (content/playground) are checked the same way.
//
// Runs only when asked, like the hostile suite:
//   scripts/content
// CONTENT_DIR names the content folder (default ../../content, from services/api).
import std.env;
import std.fs;
import std.json;
import std.process;
import std.toml;
import api.checks.files { File };
import api.checks.manifest { DEFAULT };
import api.checks.requests { RunRequest, files_request, reason };
import api.checks.job { run_job, files_job, files_value };
import api.server.sandbox { run_in_sandbox };

fun image(): string = env.get("SANDBOX_IMAGE").unwrap_or("lugha-sandbox:m159");

fun root(): string = env.get("CONTENT_DIR").unwrap_or("../../content");

/** Whether the checks were asked for, Docker has runsc and the sandbox image is built. */
fun ready(): bool {
    if env.get("SANDBOX_TESTS") != Some("1") {
        return false;
    }
    let has_runsc = match process.run("docker", ["info", "--format", "{{{{json .Runtimes}}}}"]) {
        Ok(out) => out.stdout.contains("\"runsc\""),
        Err(_) => false,
    };
    has_runsc && match process.run("docker", ["image", "inspect", image()]) {
        Ok(out) => out.code == 0,
        Err(_) => false,
    }
}

/** What one run gave: its compile error code (or ""), and its stdout. */
struct Ran {
    error: string,
    stdout: string,
}

/** Runs `source` as src/main.la with `stdin`, as the API would. */
fun run(source: string, stdin: string): Result<Ran, string> = run_files(
    [File { path: "src/main.la", text: source }],
    stdin,
);

/** Runs a project's `files`, with src/main.la as the entry and the default lugha.toml. */
fun run_files(project: File[], stdin: string): Result<Ran, string> {
    let mut all = project;
    all.push(File { path: "lugha.toml", text: DEFAULT });
    let r = RunRequest {
        files: all,
        entry: "src/main.la",
        args: [],
        stdin: stdin,
        opt: 0,
    };
    let v = run_in_sandbox(image(), ["/usr/local/bin/runner", "/work"], run_job(r)).map_err(
        fun(e) = "{e}",
    )?;
    // A step may show a warning on purpose (W0107 for `017`), so only an
    // error-severity diagnostic counts as the step's error.
    let diagnostics = json.get(v, "compile").and_then(fun(c) = json.get(c, "diagnostics")).and_then(
        json.as_array,
    ).unwrap_or([]);
    let mut error = "";
    for d of diagnostics {
        let severity = json.get(d, "severity").and_then(json.as_text).unwrap_or("");
        if error == "" && severity == "error" {
            error = json.get(d, "code").and_then(json.as_text).unwrap_or("");
        }
    }
    let stdout = json.get(v, "program").and_then(fun(p) = json.get(p, "stdout")).and_then(
        json.as_text,
    ).unwrap_or("");
    Ok(Ran { error: error, stdout: stdout })
}

/** What one Test gave: the tests that failed (by function name, sorted), how many passed, and whether they compiled. */
struct Tested {
    failed: string[],
    passed: i64,
    compiled: bool,
}

/** Runs a project's tests, as the API's Test would. */
fun test_files(project: File[]): Result<Tested, string> {
    let body = json.stringify(json.Value.Object(#{ "files": files_value(project) })).unwrap();
    let c = files_request(body).map_err(reason)?;
    let v = run_in_sandbox(image(), ["/usr/local/bin/runner", "/work"], files_job("test", c)).map_err(
        fun(e) = "{e}",
    )?;
    let mut failed: string[] = [];
    let mut passed = 0;
    for t of json.get(v, "tests").and_then(json.as_array).unwrap_or([]) {
        let status = json.get(t, "status").and_then(json.as_text).unwrap_or("");
        if status == "passed" {
            passed += 1;
        } else if status == "failed" {
            // The API names a test by its module too ("test.area.area_of_three");
            // a step names it by its function alone.
            let full = json.get(t, "test").and_then(json.as_text).unwrap_or("");
            let parts = full.split(".");
            failed.push(parts[parts.len - 1]);
        }
    }
    let compiled = json.get(v, "compile_error").and_then(json.as_text).is_none();
    Ok(Tested { failed: failed.sort(), passed: passed, compiled: compiled })
}

/** The test names in a start_failing value, sorted. */
fun names(list: string): string[] = list.split(",").map(fun(n) = n.trim()).filter(
    fun(n) = n != "",
).sort();

/**
 * Compares a Test with what was expected: every test passing when `failing`
 * is empty, otherwise exactly those tests failing.
 */
fun check_tests(problems: string[], what: string, got: Result<Tested, string>, failing: string[]): string[] {
    let mut out = problems;
    match got {
        Err(e) => out.push("{what}: no result ({e})"),
        Ok(t) => {
            if !t.compiled {
                out.push("{what}: the tests didn't compile");
            } else if failing.len == 0 && (t.failed.len > 0 || t.passed == 0) {
                out.push("{what}: expected every test to pass; failed {t.failed}, passed {t.passed}");
            } else if failing.len > 0 && t.failed != failing {
                out.push("{what}: expected {failing} to fail, failed {t.failed}");
            }
        }
    }
    out
}

/** Every file under `dir`, by its path from `dir` ("src/main.la"). */
fun project(dir: string): File[] {
    let mut out: File[] = [];
    let mut todo = [""];
    while let Some(rel) = todo.pop() {
        let here = if rel == "" { dir } else { "{dir}/{rel}" };
        for name of fs.list_dir(here).unwrap_or([]) {
            let child = if rel == "" { name } else { "{rel}/{name}" };
            if fs.is_dir("{dir}/{child}") {
                todo.push(child);
            } else {
                out.push(File { path: child, text: read_file("{dir}/{child}").unwrap_or("") });
            }
        }
    }
    out
}

/** The folders in `path`, sorted (list_dir sorts). */
fun folders(path: string): string[] = fs.list_dir(path).unwrap_or([]).filter(
    fun(n) = fs.is_dir("{path}/{n}"),
);

/**
 * Reads a key's value from a step's front matter (between the --- lines at
 * the top of its Markdown), with one pair of quotes removed and `\n` turned
 * into a newline; "" if absent.
 */
fun front(md: string, key: string): string {
    let lines = md.lines();
    if lines.len == 0 || lines[0] != "---" {
        return "";
    }
    for i in 1..lines.len {
        let line = lines[i];
        if line == "---" {
            return "";
        }
        if line.starts_with("{key}:") {
            let mut v = line.slice(key.len + 1, line.len).trim();
            if v.len >= 2 && v.starts_with("\"") && v.ends_with("\"") {
                v = v.slice(1, v.len - 1);
            }
            return v.split("\\n").join("\n");
        }
    }
    ""
}

/** Compares what ran with what was expected, adding a line to `problems` when they differ. */
fun check(
    problems: string[],
    what: string,
    got: Result<Ran, string>,
    error: string,
    stdout: string,
): string[] {
    let mut out = problems;
    match got {
        Err(e) => out.push("{what}: no result ({e})"),
        Ok(r) => {
            if error != "" && r.error != error {
                out.push(
                    "{what}: expected {error}, got {if r.error == "" { "no error" } else { r.error }}",
                );
            }
            if error == "" && r.error != "" {
                out.push("{what}: didn't compile ({r.error})");
            }
            if error == "" && r.stdout != stdout {
                out.push("{what}: printed\n{r.stdout}--- expected\n{stdout}---");
            }
        }
    }
    out
}

@test
fun every_lesson_step_prints_what_it_says() {
    if !ready() {
        skip("set SANDBOX_TESTS=1, with runsc and the sandbox image");
    }
    let mut problems: string[] = [];
    let mut steps = 0;
    let learn = "{root()}/learn";
    for chapter of folders(learn) {
        for lesson of folders("{learn}/{chapter}") {
            for step of folders("{learn}/{chapter}/{lesson}") {
                let dir = "{learn}/{chapter}/{lesson}/{step}";
                let md = read_file("{dir}/step.md").expect("every step has step.md");
                let expected = read_file("{dir}/expected.txt").expect(
                    "every step has expected.txt",
                );
                let start = project("{dir}/start");
                let tests = start.any(fun(f) = f.path.starts_with("test/"));
                steps += 1;
                if fs.is_dir("{dir}/solution") {
                    let solution = project("{dir}/solution");
                    problems = check(
                        problems,
                        "{step} (solution)",
                        run_files(solution, ""),
                        "",
                        expected,
                    );
                    if tests {
                        problems = check_tests(
                            problems,
                            "{step} (solution's tests)",
                            test_files(solution),
                            [],
                        );
                    }
                    let failing = front(md, "start_failing");
                    if failing != "" {
                        problems = check_tests(
                            problems,
                            "{step} (start's tests)",
                            test_files(start),
                            names(failing),
                        );
                    } else {
                        problems = check(
                            problems,
                            "{step} (start)",
                            run_files(start, ""),
                            front(md, "start_error"),
                            front(md, "start_output"),
                        );
                    }
                } else {
                    problems = check(problems, step, run_files(start, ""), "", expected);
                    if tests {
                        problems = check_tests(problems, "{step} (tests)", test_files(start), []);
                    }
                }
            }
        }
    }
    assert(steps > 0);
    for p of problems {
        eprintln(p);
    }
    assert_eq(problems, []);
}

@test
fun every_example_prints_what_it_says() {
    if !ready() {
        skip("set SANDBOX_TESTS=1, with runsc and the sandbox image");
    }
    let mut problems: string[] = [];
    let examples = "{root()}/examples";
    let names = folders(examples);
    assert(names.len > 0);
    for name of names {
        let dir = "{examples}/{name}";
        let meta = toml.parse(
            read_file("{dir}/example.toml").expect("every example has example.toml"),
        ).expect("example.toml is TOML");
        let stdin = toml.get(meta, "stdin").and_then(toml.as_text).unwrap_or("");
        let source = read_file("{dir}/src/main.la").expect("every example has src/main.la");
        let expected = read_file("{dir}/expected.txt").expect("every example has expected.txt");
        problems = check(problems, name, run(source, stdin), "", expected);
    }
    for p of problems {
        eprintln(p);
    }
    assert_eq(problems, []);
}

@test
fun home_and_playground_programs_print_what_they_say() {
    if !ready() {
        skip("set SANDBOX_TESTS=1, with runsc and the sandbox image");
    }
    let mut problems: string[] = [];
    for name of ["home", "playground"] {
        let dir = "{root()}/{name}";
        let source = read_file("{dir}/src/main.la").expect("the program is src/main.la");
        let expected = read_file("{dir}/expected.txt").expect("the program has expected.txt");
        problems = check(problems, name, run(source, ""), "", expected);
    }
    for p of problems {
        eprintln(p);
    }
    assert_eq(problems, []);
}
